68116&amp;amp;size=small&amp;amp;timestamp=1790337285\" alt=\"Dasgot\" style=\"background-image:url(https://www.wikidot.com/userkarma.php?u=1568116)\"/></a><a href=\"https://www.wikidot.com/user:info/dasgot\" onclick=\"WIKIDOT.page.listeners.userInfo(1568116); return false;\" >Dasgot</a></span>, <span class=\"odate time_1712145694 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover\">03 Apr 2024 12:01</span>\n\t\t</div>\n\t</div>\n \n                \n        \n            </div>\n \n\n\t\n\t\t\t\t\t\n      \n    <div class=\"post-container\" id=\"fpc-6475408\">\n                      \n\t\t<div class=\"post\" id=\"post-6475408\">\n\t\t<div class=\"long\">\n\t\t\t<div class=\"head\">\n\t\t\t\t\t\t\t\t\t<div class=\"options\">\n\t\t\t\t\t\t<a href=\"javascript:;\" onclick=\"togglePostFold(event,6475408)\" class=\"btn btn-default btn-small btn-sm\">Згорнути</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"title\" id=\"post-title-6475408\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"info\">\n\t\t\t\t\t<span class=\"printuser avatarhover\"><a href=\"https://www.wikidot.com/user:info/alanspirand\" onclick=\"WIKIDOT.page.listeners.userInfo(7683875); return false;\"  ><img class=\"small\" src=\"https://www.wikidot.com/avatar.php?userid=7683875&amp;amp;size=small&amp;amp;timestamp=1790337285\" alt=\"AlanSpirand\" style=\"background-image:url(https://www.wikidot.com/userkarma.php?u=7683875)\"/></a><a href=\"https://www.wikidot.com/user:info/alanspirand\" onclick=\"WIKIDOT.page.listeners.userInfo(7683875); return false;\" >AlanSpirand</a></span> <span class=\"odate time_1712668209 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover\">09 Apr 2024 13:10</span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"content\" id=\"post-content-6475408\">\n\t\t\t\t\t\t\t\t\t\n\n<p>Люблю такі статті. Атмосфера читання списку аномальних проявів без видимої закономірності та очевидної загрози чудово передана, дає таке собі відчуття містики. Плюсую.</p>\n\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"options\">\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<strong><a href=\"javascript:;\" onclick=\"postReply(event,6475408)\" class=\"btn btn-primary btn-small btn-sm\">Відповісти</a></strong> \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"javascript:;\" onclick=\"togglePostOptions(event,6475408)\" class=\"btn btn-default btn-small btn-sm\">Налаштування</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t<div id=\"post-options-6475408\" class=\"options\" style=\"display: none\">\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"short\">\n\t\t\t\t\t\t\t<a class=\"options btn btn-default btn-mini btn-xs\" href=\"javascript:;\" onclick=\"togglePostFold(event,6475408)\" c>Розгорнути</a>\n\t\t\t\t\t\t<a class=\"title\" href=\"javascript:;\" onclick=\"togglePostFold(event,6475408)\"></a> від <span class=\"printuser avatarhover\"><a href=\"https://www.wikidot.com/user:info/alanspirand\" onclick=\"WIKIDOT.page.listeners.userInfo(7683875); return false;\"  ><img class=\"small\" src=\"https://www.wikidot.com/avatar.php?userid=7683875&amp;amp;size=small&amp;amp;timestamp=1790337285\" alt=\"AlanSpirand\" style=\"background-image:url(https://www.wikidot.com/userkarma.php?u=7683875)\"/></a><a href=\"https://www.wikidot.com/user:info/alanspirand\" onclick=\"WIKIDOT.page.listeners.userInfo(7683875); return false;\" >AlanSpirand</a></span>, <span class=\"odate time_1712668209 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover\">09 Apr 2024 13:10</span>\n\t\t</div>\n\t</div>\n \n                \n        \n            </div>\n \n\n\t\n\t\t\t\t\t\n      \n    <div class=\"post-container\" id=\"fpc-6478981\">\n                      \n\t\t<div class=\"post\" id=\"post-6478981\">\n\t\t<div class=\"long\">\n\t\t\t<div class=\"head\">\n\t\t\t\t\t\t\t\t\t<div class=\"options\">\n\t\t\t\t\t\t<a href=\"javascript:;\" onclick=\"togglePostFold(event,6478981)\" class=\"btn btn-default btn-small btn-sm\">Згорнути</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"title\" id=\"post-title-6478981\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"info\">\n\t\t\t\t\t<span class=\"printuser avatarhover\"><a href=\"https://www.wikidot.com/user:info/vinsent-sarwill\" onclick=\"WIKIDOT.page.listeners.userInfo(6647407); return false;\"  ><img class=\"small\" src=\"https://www.wikidot.com/avatar.php?userid=6647407&amp;amp;size=small&amp;amp;timestamp=1790337285\" alt=\"Vinsent_Sarwill\" style=\"background-image:url(https://www.wikidot.com/userkarma.php?u=6647407)\"/></a><a href=\"https://www.wikidot.com/user:info/vinsent-sarwill\" onclick=\"WIKIDOT.page.listeners.userInfo(6647407); return false;\" >Vinsent_Sarwill</a></span> <span class=\"odate time_1713130886 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover\">14 Apr 2024 21:41</span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"content\" id=\"post-content-6478981\">\n\t\t\t\t\t\t\t\t\t\n\n<p>Чудовий об'єкт, один з небагатьох вартісних. На відміну від частини учасників обговорень ігри не викликають в мене ностальгічну реакцію (радше, їх відсутність спричинена відсутністю будь-якого ігрового досвіду в дитинстві). Однак, питань це не виключає.</p>\n<p>1<br />\n<em>Вебаналітичний бот Фонду &quot;I/O Синапс&quot; повинен відстежувати появу в інтернеті будь-яких згадок про прояви SCP-182-UA і видаляти їх</em> - якщо він видаляє лише згадки, а співробітники організації займаються лишень <em>&#8230;повинні визначити відправників повідомлень про SCP-182-UA та обробити їх амнезіаками класу B, а всі вражені <span style=\"text-decoration: underline;\">фізичні</span> носії та/або пристрої — вилучити&#8230;</em> - то що відбувається з <span style=\"text-decoration: underline;\">цифровими</span> копіями? Зараженими сайтами? Серверами якими вони розповсюджуються?</p>\n<p>2<br />\n<em>&#8230;суб’єкти одразу можуть відрізнити неаномальну копію відеогри від відповідної ураженої копії в невизначений досі спосіб: суб’єкти це пояснюють тим, що &quot;з грою щось не так&quot;</em> - вони оцінюють аномальну гру відповідно до неаномальної чи навпаки? Плутанина.</p>\n<p>3<br />\n<em>Вперше SCP-182-UA було виявлено ██.██.2000 після перехоплення повідомлення до районного відділу міліції про &quot;гру, яка дивно поводилась&quot;</em> - в який момент життя люди дзволять в <span style=\"text-decoration: underline;\">поліцію</span>, щоб описати проблеми з грою? Я б радше намагався звернутися до магазину чи ділка, в якого купив товар - тоді це абсолютно інший кут справ. Наприклад скарга. Чи завдання легких тілесних пошкоджень ігровою консоллю.</p>\n<p>4<br />\nЗ приводу номерів: краще використати прямий порядок (1,2,3) разом з приставкою (-1, -2, -3). Хаотичність номерів збиває з пантелику. До того ж оскільки гра може бути однаковою, але аномальні копії завжди різні - ци виглядає доречним. Можливо тих Героїв з мечами було копій тридцять.</p>\n<p>5<br />\n<em>Інцидент 182-UA-B</em> - Яким чином програма опинилася на ПК співробітника, якщо він її не завантажував та не контактував з зараженими пристроями? Я впевнений що мінімальний захист даних буде вимагати дозволу адміністратора, а не просто встановлювати перше-ліпше &quot;бо іконка красива&quot;.</p>\n<p>6<br />\n<em>Інцидент 182-UA-B</em> + <em>Після двох (2) годин безпосередньої взаємодії з ураженою грою в суб’єктів зникає цей стан. Вони заперечують факт існування таких симптомів та ігнорують аудіо- чи відеодокази</em> - Чому інформація не зникла чи не було намагання зам'яти інцидент? Якщо реальність це гра - на неї розповсюджуються ті самі правила. Якщо реальність не гра - яким чином ця програма є такою, що вважається розважальною, не маючи жодної можливості з нею взаємодіяти?</p>\n<p>Плюсек додано.</p>\n\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\t<div class=\"signature\">\n\t\t\t\t\t<hr class=\"signature-separator\"/>\n\t\t\t\t\t\n\n<p>[still alive]</p>\n\n\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"options\">\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<strong><a href=\"javascript:;\" onclick=\"postReply(event,6478981)\" class=\"btn btn-primary btn-small btn-sm\">Відповісти</a></strong> \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"javascript:;\" onclick=\"togglePostOptions(event,6478981)\" class=\"btn btn-default btn-small btn-sm\">Налаштування</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t<div id=\"post-options-6478981\" class=\"options\" style=\"display: none\">\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"short\">\n\t\t\t\t\t\t\t<a class=\"options btn btn-default btn-mini btn-xs\" href=\"javascript:;\" onclick=\"togglePostFold(event,6478981)\" c>Розгорнути</a>\n\t\t\t\t\t\t<a class=\"title\" href=\"javascript:;\" onclick=\"togglePostFold(event,6478981)\"></a> від <span class=\"printuser avatarhover\"><a href=\"https://www.wikidot.com/user:info/vinsent-sarwill\" onclick=\"WIKIDOT.page.listeners.userInfo(6647407); return false;\"  ><img class=\"small\" src=\"https://www.wikidot.com/avatar.php?userid=6647407&amp;amp;size=small&amp;amp;timestamp=1790337285\" alt=\"Vinsent_Sarwill\" style=\"background-image:url(https://www.wikidot.com/userkarma.php?u=6647407)\"/></a><a href=\"https://www.wikidot.com/user:info/vinsent-sarwill\" onclick=\"WIKIDOT.page.listeners.userInfo(6647407); return false;\" >Vinsent_Sarwill</a></span>, <span class=\"odate time_1713130886 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover\">14 Apr 2024 21:41</span>\n\t\t</div>\n\t</div>\n \n                \n        \n                      \n    <div class=\"post-container\" id=\"fpc-6479161\">\n                      \n\t\t<div class=\"post\" id=\"post-6479161\">\n\t\t<div class=\"long\">\n\t\t\t<div class=\"head\">\n\t\t\t\t\t\t\t\t\t<div class=\"options\">\n\t\t\t\t\t\t<a href=\"javascript:;\" onclick=\"togglePostFold(event,6479161)\" class=\"btn btn-default btn-small btn-sm\">Згорнути</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"title\" id=\"post-title-6479161\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"info\">\n\t\t\t\t\t<span class=\"printuser avatarhover\"><a href=\"https://www.wikidot.com/user:info/drkhmelnytsky\" onclick=\"WIKIDOT.page.listeners.userInfo(4857465); return false;\"  ><img class=\"small\" src=\"https://www.wikidot.com/avatar.php?userid=4857465&amp;amp;size=small&amp;amp;timestamp=1790337285\" alt=\"DrKhmelnytsky\" style=\"background-image:url(https://www.wikidot.com/userkarma.php?u=4857465)\"/></a><a href=\"https://www.wikidot.com/user:info/drkhmelnytsky\" onclick=\"WIKIDOT.page.listeners.userInfo(4857465); return false;\" >DrKhmelnytsky</a></span> <span class=\"odate time_1713172279 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover\">15 Apr 2024 09:11</span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"content\" id=\"post-content-6479161\">\n\t\t\t\t\t\t\t\t\t\n\n<p>1. Я думав про цей момент детальніше написати, але не зробив. Співробітники Фонду вилучають HDD і SSD (та гинші накопичувачі), на яких містяться вражені копії. Тут прикол в тому, що копії не можна скопіювати - наприклад, якщо кинеш свої файли другу, вони ураженими не будуть. Нема заражених сайтів чи серверів, аномалія саме конкретну гру на конкретному пристрої вражає. Так само з хмарним геймінгом - вражає конкретний пристрій, а не сам сервіс.<br />\n2. Одразу можуть сказати, грають вони в аномальну гру чи неаномальну. &quot;відрізнити (гру) <strong>від відповідної</strong> (ураженої гри)&quot; - про мене, досить чітко написано.<br />\n3. Всі люди різні :) Хтозна, можливо, цей феномен набагато довше вражає ігри, а Фонд випадково дізнався про нього через якраз таку нетипову поведінку?<br />\n4. Хаотичність навмисна, я не робив якоїсь закономірности. Кожна копія позначається № в тому порядку, в якому її було виявлено. Приставки типу -1 занадто сильне нагромадження дадуть (SCP-182-UA-1-3). Копій гри може бути багато, так.<br />\n5. 6. Чого ж не було намагання &quot;зам'яти&quot;? Інформація про інцидент прихована за 4 рівнем допуску. Ну й чого вона мала зникнути, це не антимем. На решту питань я не буду відповідати, щоб не розкривати таємниці, залишаю читачам самим додумати. Скажу лише, що для цього точно існує причина (можна придумати як мінімум три насправді, але загалом об'єкт писався з досить конкретною ідеєю in mind).</p>\n<p>Дякую за оцінку.</p>\n\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"options\">\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<strong><a href=\"javascript:;\" onclick=\"postReply(event,6479161)\" class=\"btn btn-primary btn-small btn-sm\">Відповісти</a></strong> \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"javascript:;\" onclick=\"togglePostOptions(event,6479161)\" class=\"btn btn-default btn-small btn-sm\">Налаштування</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t<div id=\"post-options-6479161\" class=\"options\" style=\"display: none\">\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"short\">\n\t\t\t\t\t\t\t<a class=\"options btn btn-default btn-mini btn-xs\" href=\"javascript:;\" onclick=\"togglePostFold(event,6479161)\" c>Розгорнути</a>\n\t\t\t\t\t\t<a class=\"title\" href=\"javascript:;\" onclick=\"togglePostFold(event,6479161)\"></a> від <span class=\"printuser avatarhover\"><a href=\"https://www.wikidot.com/user:info/drkhmelnytsky\" onclick=\"WIKIDOT.page.listeners.userInfo(4857465); return false;\"  ><img class=\"small\" src=\"https://www.wikidot.com/avatar.php?userid=4857465&amp;amp;size=small&amp;amp;timestamp=1790337285\" alt=\"DrKhmelnytsky\" style=\"background-image:url(https://www.wikidot.com/userkarma.php?u=4857465)\"/></a><a href=\"https://www.wikidot.com/user:info/drkhmelnytsky\" onclick=\"WIKIDOT.page.listeners.userInfo(4857465); return false;\" >DrKhmelnytsky</a></span>, <span class=\"odate time_1713172279 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover\">15 Apr 2024 09:11</span>\n\t\t</div>\n\t</div>\n \n                \n        \n            </div>\n \n            </div>\n \n\n\t\n\t\t\t\t\t\n      \n    <div class=\"post-container\" id=\"fpc-6480095\">\n                      \n\t\t<div class=\"post\" id=\"post-6480095\">\n\t\t<div class=\"long\">\n\t\t\t<div class=\"head\">\n\t\t\t\t\t\t\t\t\t<div class=\"options\">\n\t\t\t\t\t\t<a href=\"javascript:;\" onclick=\"togglePostFold(event,6480095)\" class=\"btn btn-default btn-small btn-sm\">Згорнути</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"title\" id=\"post-title-6480095\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"info\">\n\t\t\t\t\t<span class=\"printuser avatarhover\"><a href=\"https://www.wikidot.com/user:info/vtsilily\" onclick=\"WIKIDOT.page.listeners.userInfo(8208980); return false;\"  ><img class=\"small\" src=\"https://www.wikidot.com/avatar.php?userid=8208980&amp;amp;size=small&amp;amp;timestamp=1790337285\" alt=\"Vtsilily\" style=\"background-image:url(https://www.wikidot.com/userkarma.php?u=8208980)\"/></a><a href=\"https://www.wikidot.com/user:info/vtsilily\" onclick=\"WIKIDOT.page.listeners.userInfo(8208980); return false;\" >Vtsilily</a></span> <span class=\"odate time_1713294272 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover\">16 Apr 2024 19:04</span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"content\" id=\"post-content-6480095\">\n\t\t\t\t\t\t\t\t\t\n\n<p>Як я розумію, ідея об'єкту була в кріпіпастах про &quot;прокляті ігри&quot;, чи щось подібне. Хоч мені такий жанр і не дуже, але об'єкт вийшов чудовим. Особисто хотілося б подякувати за згадку Сталкера, моя улюблена серія ігор.<br />\nПлюс без вагання.</p>\n\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"options\">\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<strong><a href=\"javascript:;\" onclick=\"postReply(event,6480095)\" class=\"btn btn-primary btn-small btn-sm\">Відповісти</a></strong> \n\t\t\t\t\t\t\t\t\t\t\